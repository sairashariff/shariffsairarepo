{
  "name": "orders-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_REDIS_TESTS=1 vitest run tests/redis.integration.test.ts",
    "test:smoke": "npm run build && tsx scripts/smoke-test.ts",
    "test:load": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "autocannon": "^8.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
