REDIS_URL=redis://127.0.0.1:16379
# Set for native Redis Cluster discovery instead of standalone REDIS_URL.
# REDIS_CLUSTER_ROOTS=["rediss://redis-node-a:6379","rediss://redis-node-b:6379","rediss://redis-node-c:6379"]
PORT=3000
RATE_LIMIT_MODE=off
# Required in log-only/enforce. Populate from the approved Confluence plan table.
PRO_RATE_LIMIT=
ENTERPRISE_RATE_LIMIT=
# Supply unique, randomly generated API keys of at least 32 characters.
# API_KEYS=[{"key":"<secret>","principal":{"kind":"tenant","tenantId":"tenant-a","tier":"free"}},{"key":"<different-secret>","principal":{"kind":"admin"}},{"key":"<service-secret>","principal":{"kind":"service","tenantId":"tenant-a"}}]
API_KEYS=[]
